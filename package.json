{
  "name": "glassmoocs",
  "version": "1.0.7",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "pnpm run build:release",
    "build:release": "pnpm run build:firefox && pnpm run build:chromium",
    "build:dev": "pnpm run build:firefox:dev && pnpm run build:chromium:dev",
    "build:firefox": "node scripts/build-extension.mjs --browser firefox",
    "build:firefox:dev": "node scripts/build-extension.mjs --browser firefox --dev",
    "build:chromium": "node scripts/build-extension.mjs --browser chromium",
    "build:chromium:dev": "node scripts/build-extension.mjs --browser chromium --dev",
    "build:amo": "pnpm run build:firefox",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "eslint . && prettier --check . && pnpm run build:release",
    "package:source": "./scripts/create-amo-source-zip.sh"
  },
  "dependencies": {
    "preact": "^10.29.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@rollup/wasm-node": "^4.60.2",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "vite": "^7.2.7"
  },
  "pnpm": {
    "overrides": {
      "rollup": "npm:@rollup/wasm-node@4.60.2"
    }
  },
  "description": "INIAD MOOCs 向けのブラウザ拡張です。ページ全体をグラスモーフィズム風に調整しつつ、次の機能を追加します。",
  "main": "eslint.config.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuraryu405/glassmoocs.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kuraryu405/glassmoocs/issues"
  },
  "homepage": "https://github.com/kuraryu405/glassmoocs#readme"
}
