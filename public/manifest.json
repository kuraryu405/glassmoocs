{
  "manifest_version": 3,
  "name": "INIAD Glassmorphism",
  "version": "1.0",
  "description": "MOOCSをグラスモーフィズム化してカッコよくする拡張機能",
  "permissions": ["storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "iniad-glassmorphism@local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "options_page": "options.html",
  "action": {
    "default_title": "GlassMOOCs Settings",
    "default_popup": "popup-launcher.html"
  },
  "content_scripts": [
    {
      "matches": ["https://moocs.iniad.org/*"],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": ["https://moocs.iniad.org/*"]
    }
  ]
}
