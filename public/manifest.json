{
  "manifest_version": 3,
  "name": "INIAD Glassmorphism",
  "version": "1.0.4",
  "description": "MOOCSをグラスモーフィズム化してカッコよくする拡張機能",
  "permissions": ["storage", "downloads", "tabs", "scripting"],
  "host_permissions": ["https://moocs.iniad.org/*"],
  "optional_host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "gecko": {
      "id": "iniad-glassmorphism@local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["background/pdf.js", "background.js"],
    "preferred_environment": ["service_worker", "document"],
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "GlassMOOCs",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://moocs.iniad.org/*"],
      "css": ["styles.css"],
      "js": ["content/download-panel.js", "content.js"]
    },
    {
      "matches": ["https://docs.google.com/presentation/*"],
      "js": ["slides-export/svg-export.js", "slides-export.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": ["https://moocs.iniad.org/*"]
    }
  ]
}
